{
  "name": "dsh-plugin-teaching-commons",
  "version": "0.1.0",
  "private": true,
  "description": "Shared teaching text for ensure-ILE modes: safety rules, voice, bank usage, subject notes",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
