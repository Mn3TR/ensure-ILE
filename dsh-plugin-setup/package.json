{
  "name": "dsh-plugin-setup",
  "version": "0.1.0",
  "private": true,
  "description": "First-run conversation for ensure-ILE: ask grade, timetable, rhythm and solving preference",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./presets": {
      "types": "./lib/types/presets.d.ts",
      "default": "./lib/presets.js"
    }
  },
  "files": [
    "lib",
    "prompts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dsh-plugin-memory": "link:../dsh-plugin-memory",
    "dsh-plugin-teaching-commons": "link:../dsh-plugin-teaching-commons"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-group": "1.1.0",
    "@deepseek-ai/cordis-plugin-include": "1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-error": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-launch-environment": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^22.20.0",
    "dsh-plugin-coreset": "link:../dsh-plugin-coreset",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  }
}
